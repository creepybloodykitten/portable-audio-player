(footprint "RotaryEncoder_EC11_Horizontal_Switch"
	(version 20240108)
	(generator "antigravity")
	(layer "F.Cu")
	(descr "EC11 Horizontal Rotary Encoder with push-button switch, shaft parallel to PCB, AliExpress / Alps style")
	(tags "rotary encoder horizontal right angle switch EC11 EC12 PEC11R")
	(property "Reference" "REF**"
		(at 0 -20 0)
		(layer "F.SilkS")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Value" "RotaryEncoder_EC11_Horizontal_Switch"
		(at 0 4.5 0)
		(layer "F.Fab")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(attr through_hole)
	(duplicate_pad_numbers_are_jumpers no)
	
	(fp_line (start -5.85 -3.4) (end 5.85 -3.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 5.85 -3.4) (end 5.85 3.1) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 5.85 3.1) (end -5.85 3.1) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start -5.85 3.1) (end -5.85 -3.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	
	(fp_line (start -3.5 -3.4) (end -3.5 -8.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 3.5 -3.4) (end 3.5 -8.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start -3.5 -8.4) (end 3.5 -8.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	
	(fp_line (start -3.0 -8.4) (end -3.0 -18.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 3.0 -8.4) (end 3.0 -18.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start -3.0 -18.4) (end 3.0 -18.4) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start -1.5 -18.4) (end -1.5 -13.4) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	
	(fp_rect (start -8.5 -18.8) (end 8.5 3.6) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	
	(pad "A" thru_hole circle (at -2.5 0) (size 1.8 1.8) (drill 1.05) (layers "*.Cu" "*.Mask"))
	(pad "C" thru_hole circle (at 0 0) (size 1.8 1.8) (drill 1.05) (layers "*.Cu" "*.Mask"))
	(pad "B" thru_hole circle (at 2.5 0) (size 1.8 1.8) (drill 1.05) (layers "*.Cu" "*.Mask"))
	
	(pad "S1" thru_hole circle (at -2.5 2.5) (size 1.8 1.8) (drill 1.05) (layers "*.Cu" "*.Mask"))
	(pad "S2" thru_hole circle (at 2.5 2.5) (size 1.8 1.8) (drill 1.05) (layers "*.Cu" "*.Mask"))
	
	(pad "" thru_hole oval (at -6.75 1.25) (size 2.6 3.0) (drill oval 1.8 2.2) (layers "*.Cu" "*.Mask"))
	(pad "" thru_hole oval (at 6.75 1.25) (size 2.6 3.0) (drill oval 1.8 2.2) (layers "*.Cu" "*.Mask"))
	
	(model "${KIPRJMOD}/libs/EC11_Encoder/EC11_Horizontal.step"
		(offset (xyz 0 3.55 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 180))
	)
)
