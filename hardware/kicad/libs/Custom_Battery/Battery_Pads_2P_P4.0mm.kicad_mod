		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(attr through_hole)
	(duplicate_pad_numbers_are_jumpers no)
	
	(fp_rect (start -4.5 -3.2) (end 4.5 3.2) (stroke (width 0.15) (type solid)) (fill no) (layer "F.SilkS"))
	(fp_rect (start -4.8 -3.5) (end 4.8 3.5) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	
