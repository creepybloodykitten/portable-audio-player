	(pad "1" thru_hole rect (at -2.0 0) (size 2.5 2.5) (drill 1.3) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole circle (at 2.0 0) (size 2.5 2.5) (drill 1.3) (layers "*.Cu" "*.Mask"))
)
